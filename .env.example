# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# See docs/payments/lenco-integration.md for setup details.

# sandbox | production
LENCO_ENV=sandbox

LENCO_SANDBOX_BASE_URL=https://sandbox.lenco.co/access/v2
LENCO_PRODUCTION_BASE_URL=https://api.lenco.co/access/v2

# From your Lenco App dashboard — never hardcode, never log, never commit. Webhook signature
# verification derives its HMAC key from LENCO_SECRET_KEY (see docs/payments/lenco-integration.md)
# — there is no separate webhook secret in Lenco's scheme.
LENCO_SECRET_KEY=
LENCO_PUBLIC_KEY=

# --- M-Pesa (Daraja) — DRAFT, NOT LIVE ---
# Mobile-money checkout stays disabled ("M-Pesa payment gateway unavailable") until ALL of these
# are filled in. See backend/payments/mpesa/MpesaGateway.js and client.js for the "not verified
# against a live sandbox" caveat before actually using this in production.
#
# sandbox | production
MPESA_ENV=sandbox

MPESA_SANDBOX_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_PRODUCTION_BASE_URL=https://api.safaricom.co.ke

# From your Daraja app (https://developer.safaricom.co.ke/MyApps) — never hardcode, never log,
# never commit.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# The Paybill/Till number ("BusinessShortCode") and its matching Lipa Na M-Pesa Online passkey.
# Daraja's sandbox publishes a shared test shortcode + passkey for development; production
# values come from Safaricom once Winrose's paybill/till is set up.
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Must be a publicly reachable HTTPS URL — Safaricom cannot call back to localhost/a LAN
# address. Use a tunnel (e.g. ngrok) for sandbox testing; this app listens for the callback at
# POST /api/payments/webhook/mpesa.
MPESA_CALLBACK_URL=

# Cloud sync API (Phase 1) — unrelated to Lenco, listed here since it's the other externally
# configurable URL this app uses. Point this at the EC2 instance's public DNS/IP in production.
CLOUD_SYNC_URL=http://127.0.0.1:8787

# --- Phase 5: docker compose stack (cloud-sync-api + Postgres) ---
# These four are only read by docker-compose.yml (via ${VAR} substitution) and by the sync-api
# container itself (DATABASE_URL is assembled from them) — not by the Electron app directly.
POSTGRES_USER=syncapi
POSTGRES_PASSWORD=syncapi
POSTGRES_DB=store_pos_sync
POSTGRES_PORT=5432
SYNC_API_PORT=8787
